{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XenoCut",
  "version": "0.1.0",
  "identifier": "app.xenocut.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:43123",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "XenoCut",
        "width": 1100,
        "height": 780,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#2a2a2a",
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data: asset: http://asset.localhost https://asset.localhost; media-src 'self' blob: data: asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:43123 ws://127.0.0.1:43123"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ffmpeg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
